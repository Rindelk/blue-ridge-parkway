    </Folder>
    <Folder>
      <name>Points of Interest</name>
      <Placemark>
        <name>Hanmer Home Base (Expedition Origin &amp; Return)</name>
        <description>Expedition home base in Hanmer, Ontario. Stage 2025 RAM 2500 Cummins and hitch 16ft enclosed cargo trailer with 4 Hondas.</description>
        <Point>
          <coordinates>-80.975400,46.647300,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>ONroute Innisfil (Hwy 400 Southbound)</name>
        <description>Ontario 400-series travel plaza. Ultra-Low Sulfur Diesel, DEF jugs, Tim Hortons, and dedicated trailer pull-through parking.</description>
        <Point>
          <coordinates>-79.673900,44.312500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Queenston-Lewiston Bridge (US Customs &amp; Border Protection)</name>
        <description>International border crossing into Lewiston, NY. Wide commercial truck/trailer inspection booths. Present passports, vehicle/trailer green slips, and motorcycle ownerships.</description>
        <Point>
          <coordinates>-79.043900,43.155800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Sunoco / Kwik Fill Springville (US-219)</name>
        <description>Easy high-clearance diesel fuel stop along US-219 expressway south of Buffalo. ULSD diesel &amp; snacks.</description>
        <Point>
          <coordinates>-78.678900,42.505600,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Pilot Travel Center Milesburg (I-80 / I-99 Exit 158)</name>
        <description>Major commercial truck stop midway across Pennsylvania. High-flow satellite diesel pumps, bulk DEF at the pump, clean restrooms, and truck/trailer parking.</description>
        <Point>
          <coordinates>-77.778900,40.945600,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Pilot Travel Center Cumberland (I-68 Exit 44)</name>
        <description>Maryland I-68 mountain corridor diesel fueling with wide turning apron for 40-ft truck/trailer rig.</description>
        <Point>
          <coordinates>-78.705600,39.678900,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Pilot Travel Center Winchester (I-81 Exit 323)</name>
        <description>Final diesel top-up before arriving in Front Royal. Bulk DEF, truck wash, and staging plaza.</description>
        <Point>
          <coordinates>-78.134200,39.245600,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Eagle's Nest RV, Boat &amp; Vehicle Storage</name>
        <description>Basecamp tow vehicle &amp; cargo trailer storage. Gated keypad access, 24/7 video recording, wide pull-through lanes.</description>
        <Point>
          <coordinates>-78.204500,38.961200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Front Royal North Entrance Station</name>
        <description>Mile 0.0 northern terminus of Skyline Drive in Shenandoah National Park.</description>
        <Point>
          <coordinates>-78.198900,38.905600,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Shenandoah Valley Overlook (MP 2.8)</name>
        <description>Sweeping panoramic vista across the Shenandoah Valley and Massanutten Mountain.</description>
        <Point>
          <coordinates>-78.205600,38.877800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Dickey Ridge Visitor Center (MP 4.6)</name>
        <description>First visitor center on Skyline Drive with park exhibits, maps, and restrooms.</description>
        <Point>
          <coordinates>-78.202500,38.859200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Hogback Overlook (MP 21.0)</name>
        <description>Longest continuous overlook on Skyline Drive with views of 11 bends of Shenandoah River.</description>
        <Point>
          <coordinates>-78.275800,38.756100,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Mary's Rock Tunnel (Skyline MP 32.2)</name>
        <description>Historic 670-ft granite tunnel bored through solid rock in 1932. Clearance: 12 ft 8 in.</description>
        <Point>
          <coordinates>-78.318200,38.657500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Skyland Resort (MP 41.7)</name>
        <description>Historic high-elevation resort built in 1888 with dining room and blackberry ice cream pie.</description>
        <Point>
          <coordinates>-78.381400,38.591900,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Big Meadows Wayside &amp; Center (MP 51.0)</name>
        <description>Natural high-elevation meadow with gas station, camp store, and Byrd Visitor Center.</description>
        <Point>
          <coordinates>-78.435200,38.519200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Big Meadows Wayside Gas (MP 51.0)</name>
        <description>Mid-Skyline Drive fuel stop. 87 Regular available. Rebel 1100 safety top-up at 53 miles.</description>
        <Point>
          <coordinates>-78.436100,38.517800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Dark Hollow Falls Trailhead (MP 50.7)</name>
        <description>Popular 1.4-mile roundtrip hike descending 440 ft to a cascading 70-foot waterfall.</description>
        <Point>
          <coordinates>-78.428900,38.519500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>South River Overlook (MP 62.8)</name>
